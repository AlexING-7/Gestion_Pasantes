                   <property name="styleSheet">
                    <string notr="true">
/* Estilo de los botones laterales */
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 25px;
    border: none;
    background-color: transparent;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 3px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 3px;
}

/* Manejo de los iconos (Flechas) */
QSpinBox::up-arrow {
    image: url(resources/images/arrow-up-svgrepo-com.svg); /* Tu icono aquí */
    width: 15px;
    height: 15px;
}

QSpinBox::down-arrow {
    image: url(resources/images/arrow-down-svgrepo-com.svg); /* Tu icono aquí */
    width: 15px;
    height: 15px;
}

/* Efecto Hover para feedback visual */
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: rgb(225, 225, 225);
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background-color: rgb(225, 225, 225);
}</string>
                   </property>
                   <property name="minimum">
