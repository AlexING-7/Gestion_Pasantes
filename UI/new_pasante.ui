                    <string notr="true">
            QDateEdit {
                border: 1px solid #ced4da;
                border-radius: 4px;
                padding:5px 10px;
                color: #333333;
                font-size: 13px;
                background-color: white;
            }
QDateEdit::down-arrow {
   image: url(resources/images/down-arrow-svgrepo-com.svg); /* Ruta a tu imagen */
    width: 12px;  /* Ajusta el tamaño del icono */
    height: 12px;
}

