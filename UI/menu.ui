                     <property name="styleSheet">
                      <string notr="true">QLineEdit {
                background-color: #f0f0f0;
                border: 2px solid #e0e0e0;
                border-radius: 18px; /* Bordes muy redondos */
                padding: 5px 10px;
                padding-left: 5px; /* Espacio extra para el icono */
                font-size: 14px;
                color: #333;
                selection-background-color: #0078d7;
            }
            QLineEdit:focus {
                border: 2px solid #0078d7; /* Color de acento al escribir */
                background-color: #ffffff;
            }
            QLineEdit:hover {
                border: 2px solid #ccc;
            }
        </string>
