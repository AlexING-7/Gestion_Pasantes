                   <item>
                    <widget class="QLineEdit" name="searchTutorA">
                     <property name="styleSheet">
                      <string notr="true">QLineEdit {
                background-color: #f0f0f0;
                border: 2px solid #e0e0e0;
                border-radius: 18px; /* Bordes muy redondos */
                padding: 5px 10px;
                padding-left: 5px; /* Espacio extra para el icono */
                font-size: 14px;
                color: #333;
                selection-background-color: #0078d7;
            }
            QLineEdit:focus {
                border: 2px solid #0078d7; /* Color de acento al escribir */
                background-color: #ffffff;
            }
            QLineEdit:hover {
                border: 2px solid #ccc;
            }
        </string>
                     </property>
                     <property name="text">
                      <string/>
                     </property>
                    </widget>
                   </item>
                   <item>
                    <widget class="QComboBox" name="comboEspecialidad">
                     <property name="styleSheet">
                      <string notr="true">/* Estilo principal del ComboBox */
QComboBox {
    background-color: rgb(245, 247, 250);
    border: 1px solid #d1d9e6; /* Un borde suave que combina con el fondo */
    border-radius: 4px;
    padding: 5px 15px;
    font-size: 14px;
    color: #2e3440; /* Gris muy oscuro para buen contraste */
    min-height: 25px;
}

/* Estado cuando pasas el ratón por encima */
QComboBox:hover {
    border: 1px solid #aeb9cc;
    background-color: #ffffff; /* Se aclara un poco al interactuar */
}

/* Estado cuando el combo está abierto */
QComboBox:on { 
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border: 2px solid #5e81ac; /* Color de énfasis (azul) al estar activo */
}

/* Estilo del botón de la flecha */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px; /* Quitamos la línea divisoria para un look más limpio */
}

/* Estilo de la flecha (puedes usar un caracter o una imagen) */
QComboBox::down-arrow {
    image: url(resources/images/down-arrow-svgrepo-com.svg); /* Si tienes un icono */
    width: 12px;
    height: 12px;
}

/* Estilo de la lista desplegable (el menú) */
QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid ;
    selection-background-color: #5e81ac; /* Color de fondo al seleccionar un item */
    selection-color: white;
    outline: none;
    border-radius: 0px;
	color:#000;
}</string>
                     </property>
                     <property name="placeholderText">
                      <string>Todas las Especialidades</string>
                     </property>
                    </widget>
                   </item>
                  </layout>
                 </item>
                 <item>
                  <widget class="QTableWidget" name="tabla_TutorA">
                   <property name="enabled">
                    <bool>true</bool>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">/* 1. Estilo General de la Tabla */
QTableWidget {
    background-color: #ffffff;
    /* Color alterno para filas (efecto cebra) */
    alternate-background-color: #f4f6f9; 
    color: #2b2b2b;
    font-size: 14px;
    
    /* Borde exterior suave */
    border: 1px solid #dcdcdc;
    
    /* Color de las líneas de la cuadrícula más sutil */
    gridline-color: #e0e0e0;
}

/* 2. Estilo de los Ítems (Celdas) 
QTableWidget::item {
 
	padding:5px;
    border-bottom: 1px solid #f0f0f0;
}*/

/* 3. Estilo de Selección 
QTableWidget::item:selected {
    outline: 0; 
}*/

QTableWidget::item:hover {
    /* Opcional: un ligero gris al pasar el mouse por una celda no seleccionada */
    background-color: #e6eaf0;
    color: #000000;
}

/* 4. Estilo de los Encabezados (Header) */
QHeaderView::section {
    background-color: #003366;
    color: white;
    font-weight: bold; /* Negrita para destacar */
    padding: 6px;      /* Más altura al encabezado */
    border: none;      /* Sin bordes individuales feos */
    
    /* Separador sutil a la derecha */
    border-right: 1px solid #002244; 
    border-bottom: 2px solid #002244;
}

/* 5. La esquina superior izquierda (donde se cruzan los headers) */
QTableCornerButton::section {
    background-color: #003366;
    border: 1px solid #003366;
}</string>
