                       <item>
                        <widget class="QListWidget" name="listDocsPasante">
                         <property name="styleSheet">
                          <string notr="true">QListWidget {
                background-color: transparent;
                border: 1px solid #ccc;
				padding:0px;
            }
/*ListView::item:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #FAFBFE, stop: 1 #DCDEF1);
}*/
QScrollBar:vertical {
        border: none;
        background: #2d2d2d;
        width: 12px;
        margin: 0px 0px 0px 0px;
        border-radius: 5px;
    }

    /* El &quot;tirador&quot; o parte movible */
    QScrollBar::handle:vertical {
        background: #5c5c5c;
        min-height: 20px;
        border-radius: 5px;
    }

    /* Color al pasar el mouse por el tirador */
    QScrollBar::handle:vertical:hover {
        background: #7a7a7a;
    }

    /* Ocultar las flechas de arriba y abajo */
    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
        height: 0px;
    }

    /* Fondo de la barra donde no está el tirador */
    QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
        background: none;
    }</string>
                         </property>
                         <property name="viewMode">
                          <enum>QListView::ViewMode::IconMode</enum>
                         </property>
                        </widget>
                       </item>
